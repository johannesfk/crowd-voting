{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "crowd-voting",
	"compatibility_date": "2026-10-10",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crowd-voting",
			"database_id": "local"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "crowd-voting-photos"
		}
	],
	"workers_dev": true,
	"preview_urls": true
}
