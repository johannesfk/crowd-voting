{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "crowd-voting",
	"compatibility_date": "2026-10-10",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
	  "issues": {"enabled": true},
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"persist": true
		}
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crowd-voting",
			"database_id": "646c0ecd-0fa1-4917-8779-7cc9c42a2389",
			// drizzle 1 writes one folder per migration, with the SQL inside it.
			// Wrangler only finds that layout when told to, and it records each
			// migration in `d1_migrations` under its path relative to `migrations_dir`.
			"migrations_dir": "migrations",
			"migrations_pattern": "migrations/*/migration.sql"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "crowd-voting-photos"
		}
	]
}
